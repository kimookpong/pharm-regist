{
  "name": "pharm-regist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix web run build",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply pharm-regist-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pharm-regist-db --remote",
    "db:seed:local": "wrangler d1 execute pharm-regist-db --local --file=./scripts/seed.sql"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.111.0"
  }
}
